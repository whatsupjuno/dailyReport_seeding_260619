# ============================================================
# Seeding — env template (safe to commit). Copy to .env.local and fill in.
# ============================================================

# ----- App -----
APP_BASE_URL=http://localhost:3000
TZ=Asia/Seoul
SESSION_SECRET=replace-with-strong-random

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql://seeding:seeding@localhost:5432/seeding

# ----- Mail transport -----
# log = no real send (dev/test default). ncp = real NCP Outbound Mailer.
MAIL_TRANSPORT=log
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME=Seeding

# ----- Naver Cloud Platform : Outbound Mailer -----
NCP_ACCESS_KEY_ID=
NCP_SECRET_KEY=
# DNS TXT record value for sending-domain verification
NCP_MAILER_DOMAIN_VERIFICATION=
