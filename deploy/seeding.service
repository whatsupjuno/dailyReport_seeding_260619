[Unit]
Description=Seeding daily report app
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/apps/seeding
Environment=NODE_ENV=production
Environment=PORT=5001
ExecStart=/usr/bin/node /opt/apps/seeding/node_modules/next/dist/bin/next start -p 5001
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
